{
  "manifest_version": 3,
  "name": "SubTutor - 자막 튜터",
  "version": "1.16.0",
  "description": "넷플릭스·유튜브·프라임 비디오·디즈니+·TVNZ+·NZ On Screen·TED·Vimeo 등 영상 자막으로 영어 공부: 자막 목록, 한국어 번역, A/S/D 반복 단축키, 자동 일시정지, 쉐도잉, 더빙, 자막·오디오 저장, 받아쓰기 퀴즈",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SubTutor",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "unlimitedStorage",
    "tabCapture",
    "downloads",
    "activeTab",
    "offscreen",
    "contextMenus",
    "scripting"
  ],
  "commands": {
    "save-cue": {
      "suggested_key": {
        "default": "Alt+E",
        "mac": "Alt+E"
      },
      "description": "지금 자막 별표 저장 (이 탭의 오디오 녹음 허용 포함)"
    }
  },
  "host_permissions": [
    "https://*.netflix.com/*",
    "https://*.nflxvideo.net/*",
    "https://www.youtube.com/*",
    "https://*.primevideo.com/*",
    "https://*.amazon.com/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.co.jp/*",
    "https://*.amazon.de/*",
    "https://*.amazon.com.au/*",
    "https://*.disneyplus.com/*",
    "https://translate.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://*.tvnz.co.nz/*",
    "https://*.threenow.co.nz/*",
    "https://*.nzonscreen.com/*",
    "https://nzonscreen.com/*",
    "https://*.maoriplus.co.nz/*",
    "https://*.ted.com/*",
    "https://vimeo.com/*",
    "https://*.vimeo.com/*",
    "https://*.brightcove.com/*",
    "https://*.brightcovecdn.com/*",
    "https://*.boltdns.net/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "src/page/netflix-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://*.amazon.com/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.co.jp/*",
        "https://*.amazon.de/*",
        "https://*.amazon.com.au/*"
      ],
      "js": [
        "src/page/prime-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "js": [
        "src/page/disney-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/page/youtube-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://*.amazon.com/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.co.jp/*",
        "https://*.amazon.de/*",
        "https://*.amazon.com.au/*",
        "https://www.disneyplus.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/lib/subtitles.js",
        "vendor/lamejs/lame.min.js",
        "src/lib/audio.js",
        "src/lib/stretch.js",
        "src/data/freq-en.js",
        "src/data/kiwi.js",
        "src/data/nzVowels.js",
        "src/lib/speech.js",
        "src/lib/vocab.js",
        "src/lib/explain.js",
        "src/lib/sites.js",
        "src/content/adapters.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tvnz.co.nz/*",
        "https://www.threenow.co.nz/*",
        "https://www.nzonscreen.com/*",
        "https://nzonscreen.com/*",
        "https://www.maoriplus.co.nz/*",
        "https://www.ted.com/*",
        "https://vimeo.com/*",
        "https://www.vimeo.com/*"
      ],
      "js": [
        "src/page/generic-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.tvnz.co.nz/*",
        "https://www.threenow.co.nz/*",
        "https://www.nzonscreen.com/*",
        "https://nzonscreen.com/*",
        "https://www.maoriplus.co.nz/*",
        "https://www.ted.com/*",
        "https://vimeo.com/*",
        "https://www.vimeo.com/*"
      ],
      "js": [
        "src/lib/subtitles.js",
        "vendor/lamejs/lame.min.js",
        "src/lib/audio.js",
        "src/lib/stretch.js",
        "src/data/freq-en.js",
        "src/data/kiwi.js",
        "src/data/nzVowels.js",
        "src/lib/speech.js",
        "src/lib/vocab.js",
        "src/lib/explain.js",
        "src/lib/sites.js",
        "src/content/adapters.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://bluemuple.github.io/subtutor/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/content/bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
